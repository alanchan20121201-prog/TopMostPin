<Window x:Class="TopMostPin.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopMostPin.Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        MaxWidth="380"
        Left="-20000"
        Top="-20000"
        Opacity="0">

    <!-- 轻量提示浮窗：出现在鼠标附近，不抢焦点、不拦截点击，2.5 秒后自动淡出。
         比系统托盘气泡可靠（气泡受"通知开关"影响，且首次弹出有明显延迟）。 -->
    <Border x:Name="Card"
            Background="#F21F2A37"
            CornerRadius="8"
            Padding="12,10"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <!-- 左侧色条：蓝色=普通提示，橙色=警告 -->
            <Border x:Name="AccentBar"
                    Width="4"
                    CornerRadius="2"
                    Background="#FF29B6F6"
                    Margin="0,1,10,1" />

            <TextBlock x:Name="MessageText"
                       Foreground="#FFF2F6FA"
                       FontSize="13"
                       LineHeight="19"
                       MaxWidth="316"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
