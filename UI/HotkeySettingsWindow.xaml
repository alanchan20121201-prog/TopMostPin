<Window x:Class="TopMostPin.UI.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改快捷键"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontSize="13"
        Background="#FFF6F8FA"
        PreviewKeyDown="OnPreviewKeyDown">

    <StackPanel Margin="22">

        <TextBlock Text="按下新的快捷键组合" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="必须包含 Ctrl / Alt / Shift / Win 中的至少一个，按 Esc 取消。"
                   Foreground="#FF6B7683" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

        <!-- 快捷键录制框：只显示，不接受正常输入 -->
        <Border Background="White" BorderBrush="#FFC9D3DE" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="ComboText"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     CaretBrush="Transparent"
                     BorderThickness="0"
                     Background="Transparent"
                     FontSize="18"
                     TextAlignment="Center"
                     Padding="0,12"
                     Text="Ctrl+Alt+T" />
        </Border>

        <TextBlock x:Name="HintText"
                   Foreground="#FFC62828"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="2,8,0,0"
                   MinHeight="18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Style="{StaticResource DialogButton}" IsDefault="True" Click="OnConfirmClick" />
            <Button Content="取消" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
