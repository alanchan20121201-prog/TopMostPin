<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- WPF 做主界面 / 高亮层；WinForms 只用来提供系统托盘图标 NotifyIcon（属于 .NET 自带框架，不是第三方） -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>TopMostPin</AssemblyName>
    <RootNamespace>TopMostPin</RootNamespace>
    <Version>1.0.0</Version>
    <Product>TopMostPin</Product>
    <AssemblyTitle>TopMostPin</AssemblyTitle>

    <!-- 自定义清单：声明 DPI 感知，保证 GetCursorPos/GetWindowRect 返回真实物理像素 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 只保留英文资源，减小体积 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- WFAC010：WinForms 分析器建议把 DPI 设置放到代码里。
         本项目是 WPF 应用，必须由清单声明 PerMonitorV2（WPF 启动时读取清单），
         所以这里屏蔽该提示。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- WinForms SDK 默认会全局 using System.Windows.Forms / System.Drawing，
       这会让 WPF 的 Application、KeyEventArgs 等类型产生二义性。
       这里移除全局导入，改为在需要的文件里显式 using。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
